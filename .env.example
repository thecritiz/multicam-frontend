REACT_APP_SERVER_URL=https://multicam-backend.onrender.com

# Drover (ABR broadcast server) base URL — enables the Go Live button.
# ws(s):// ingest and the /watch.html viewer link are both derived from this.
# REACT_APP_DROVER_URL=http://localhost:8000

# TURN relay (coturn) — optional. When unset, calls are STUN-only (fails on
# symmetric NAT/CGNAT). URL may be a comma-separated list, e.g.
# turn:turn.example.com:3478,turns:turn.example.com:5349
# REACT_APP_TURN_URL=
# REACT_APP_TURN_USERNAME=
# REACT_APP_TURN_CREDENTIAL=
